generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id          Int            @id @default(autoincrement())
  name        String
  description String
  githubUrl   String?
  linkedinUrl String?
  websiteUrl  String?
  skills      ProfileSkill[]
  experiences Experience[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model Skill {
  id       Int            @id @default(autoincrement())
  name     String         @unique
  profiles ProfileSkill[]
}

model ProfileSkill {
  profileId Int
  skillId   Int
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill     Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([profileId, skillId])
  @@index([skillId])
}

model Company {
  id         Int          @id @default(autoincrement())
  name       String
  websiteUrl String?
  Experience Experience[]
}

model Experience {
  id        Int       @id @default(autoincrement())
  position  String
  startDate DateTime
  endDate   DateTime?
  companyId Int
  company   Company   @relation(fields: [companyId], references: [id])
  profileId Int
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  projects  Project[]

  @@index([companyId])
  @@index([profileId])
}

model Project {
  id           Int        @id @default(autoincrement())
  name         String
  description  String?
  url          String?
  repoUrl      String?
  achievements String[]
  experienceId Int
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@index([experienceId])
}
